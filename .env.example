NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
PABBLY_WEBHOOK_SECRET=some-long-random-secret-you-generate
# Indulge Shop app -> /api/webhooks/leads?source=shop_app (its own bearer token,
# deliberately NOT shared with Pabbly: a leak on either sender must be rotatable
# without breaking the other). Server-side only, never in any client bundle.
SHOP_APP_WEBHOOK_SECRET=another-long-random-secret-you-generate
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Deepgram (voice-note transcription — server-only, never NEXT_PUBLIC_)
DEEPGRAM_API_KEY=

# Anthropic (Elaya LLM layer — server-only, never NEXT_PUBLIC_; S-11)
ANTHROPIC_API_KEY=

# Python brain (Step 3) — server-only, never NEXT_PUBLIC_ (S-11).
# BRAIN_API_SECRET is the shared bearer in BOTH directions (Node → brain chat,
# brain → Node write bridge). It lives in FOUR places that must move together:
# backend/.env, this file's .env.local, Vercel prod env, SSM
# /copilot/serene/prod/secrets/BRAIN_API_SECRET (docs/operations/maintenance.md #4).
BRAIN_API_SECRET=
# Where Node reaches the brain. Local: the uvicorn port (see docs/modules/elaya.md).
# Production: the HTTPS CloudFront front on the Fargate load balancer — a plain
# http:// value is refused in production (the bearer must never cross in cleartext).
ELAYA_BRAIN_URL=http://localhost:8321
# Upstash Redis (required — server-only, never NEXT_PUBLIC_)
UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Web Push / VAPID (PWA push delivery — generate once with `npx web-push generate-vapid-keys`).
# PRIVATE key + SUBJECT are server-only (never NEXT_PUBLIC_, S-11). The PUBLIC key is also
# exposed to the client (the browser needs it to call pushManager.subscribe) — it is mirrored
# under NEXT_PUBLIC_VAPID_PUBLIC_KEY. Keep both copies of the public key identical.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tech@indulge.global
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

#comment
# Freshdesk mirror (migration 0193, the /freshdesk page + the minute sync). Server-only,
# never NEXT_PUBLIC_. The API key is a personal agent key from Freshdesk profile settings;
# the account allows 50 calls a minute shared with the member app (constants/freshdesk.ts).
# The webhook secret is what Freshdesk's automation rules send in x-freshdesk-webhook-secret
# (scripts/freshdesk/register-webhooks.ts). The Trigger.dev worker needs DOMAIN + API_KEY too.
FRESHDESK_DOMAIN=indulge.freshdesk.com
FRESHDESK_API_KEY=
FRESHDESK_WEBHOOK_SECRET=

# Zoho Books (read only; the organisation lives in the India data centre)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
# Optional: accounts host override (default accounts.zoho.in)
# ZOHO_ACCOUNTS_HOST=accounts.zoho.in
