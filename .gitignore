!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# trigger.dev
.trigger

# python (scripts/)
__pycache__/
*.pyc
*.pyo

# data exports — contain customer PII, never commit
/scripts/data/

# graphify — keep graph.json / wiki / reports, drop the regenerable AST cache
/graphify-out/cache/

# claude code — local machine settings (keep settings.json tracked for the team)
.claude/settings.local.json

# editor / OS
*.swp
*.swo
Thumbs.db

# direnv (per-project Supabase account binding)
.direnv/
.envrc
.env*

# personal/local data — never commit
"amit sir - leads.csv"
amit sir - leads.csv
elaya-model/

# Client-PII exports — never commit (Sia mapping inputs live locally only)
*client-export*.csv
Subscription Manager*.csv
mapping-review*.csv
*leads.csv

# Vendor cleanup audit dumps — written by scripts/vendors/dedupe-vendors.ts
# before it deletes anything. They carry real vendor and CLIENT rows, phone
# numbers included, so they are a local safety net and never a repo artifact.
vendor-junk-purged-*.json
vendor-removed-*.json

# Supabase CLI local state (per-machine: linked project, branch, schema cache)
supabase/.branches/
supabase/.temp/

# Member PII sheets and the concierge roster (2026-09-15) — never commit
cleint-data/
export-*.csv
sia-agents-roster.md

# Zoho Books OpenAPI specs and the download archive (reference only, 2.9 MB)
zoho books-api/
openapi-all.zip
# local scratch
.impeccable/
ok.md

# local-only: generated UI previews and a reference copy of another app
/output/
/indulge-app-example/
