/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pnpm-debug.log*

# env files
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
